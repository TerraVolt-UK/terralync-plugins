{
  "id": "ohme-ev",
  "name": "Ohme EV Charger",
  "version": "1.0.0",
  "min_terralync": "1.0.0",
  "author": "TerraLync Team",
  "description": "Live Ohme EV charger telemetry for TerraLync Lite. Stops the house battery discharging into the car while charging, feeds planned charge windows to the Energy Planner as cheap-rate opportunities, and corrects the load forecast for EV draw.",
  "license": "MIT",
  "homepage": "https://github.com/TerraVolt-UK/terralync-plugins",
  "entry_point": "main.py",

  "permissions": {
    "read_inverter_data": true,
    "write_inverter": false,
    "read_historian": false,
    "write_scheduler": false,
    "network_access": true,
    "quick_actions": true,
    "filesystem": "own_dir"
  },

  "provides": ["tariff.rates", "load.adjust"],

  "esp32": {
    "min_heap_kb": 40,
    "boards": ["geek-16mb", "guition-16mb", "s3-16mb", "s3-8mb"],
    "api_level": 1
  },

  "lifecycle": {
    "start_delay_seconds": 8,
    "restart_on_crash": true,
    "max_restarts": 3,
    "restart_cooldown_seconds": 60,
    "health_check_interval_seconds": 60
  }
}
